     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x31": {
   "name": "Message 0x31",
   "signals": {
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 6,
       "role": "hvac.power"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 1,
     "values": {
      "0": "0",
      "1": "1",
      "2": "1",
      "3": "3"
     },
     "label": "air recirc on off"
    },
    "hvac_ac": {
     "start_byte": 1,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 2,
     "bits": {
      "front defrost on off": {
       "bit": 4,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 2,
     "bits": {
      "rear defrost on off": {
       "bit": 5,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "outside_temp": {
