{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "jeep-hdpatriot",
 "name": "Jeep (HdPatriotProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder HdPatriotProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": []
 },
 "variants": [
  {
   "name": "Jeep Patriot 2011-2016, all trims"
  },
  {
   "name": "Jeep Patriot 2011-2016, low trim"
  }
 ],
