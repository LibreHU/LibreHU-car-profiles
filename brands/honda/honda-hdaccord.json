{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "honda-hdaccord",
 "name": "Honda (HdAccordProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder HdAccordProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "car type",
    "cmd": "0xF2",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Honda accord 2013-2014, all trims",
   "send": {
    "car type": "10 01"
   }
  },
  {
   "name": "Honda accord 2013-2014, high trim",
   "send": {
    "car type": "10 01"
   }
  },
  {
   "name": "Honda accord 2013-2014, medium-low trim",
   "send": {
    "car type": "10 01"
   }
  },
  {
   "name": "Honda accord 2015-2016, all trims",
   "send": {
    "car type": "10 01"
   }
  }
 ],
 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 2,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "vehicle_speed": {
     "start_byte": 1,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "speed"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_hood": {
     "start_byte": 2,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x16": {
   "name": "Message 0x16",
   "signals": {
    "fuel_instant": {
     "start_byte": 0,
     "signed": true,
     "role": "fuel.instant",
     "unit": "L/100 km",
     "label": "inst fuel cont"
    },
    "vehicle_odometer": {
     "start_byte": 13,
     "signed": true,
     "role": "vehicle.odometer",
     "unit": "km",
     "label": "odo"
    }
   }
  },
  "0x31": {
   "name": "Message 0x31",
   "signals": {
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 0,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 6,
       "role": "hvac.power"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 1,
     "bits": {
      "air recirc on off": {
       "bit": 4,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_seat_heat_left": {
     "start_byte": 2,
     "start_bit": 0,
     "bit_length": 2,
     "role": "hvac.seat_heat_left",
     "label": "fl seat warmer level"
    },
    "hvac_seat_heat_right": {
     "start_byte": 2,
     "start_bit": 2,
     "bit_length": 2,
     "role": "hvac.seat_heat_right",
     "label": "fr seat warmer level"
    },
    "hvac_defrost_front": {
     "start_byte": 2,
     "bits": {
      "front defrost on off": {
       "bit": 4,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 5,
     "signed": true,
     "role": "hvac.fan",
     "label": "front wind level"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2
 },
 "examples": [
  {
   "cmd": "0x11",
   "data": "04",
   "expect": {
    "back car state": true
   }
  },
  {
   "cmd": "0x12",
   "data": "00 00 04",
   "expect": {
    "front box door": true
   }
  },
  {
   "cmd": "0x16",
   "data": "12",
   "expect": {
    "fuel_instant": 18.0
   }
  },
  {
   "cmd": "0x31",
   "data": "01",
   "expect": {
    "ac on off": true
   }
  }
 ]
}