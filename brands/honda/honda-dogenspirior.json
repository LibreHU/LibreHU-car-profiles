{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "honda-dogenspirior",
 "name": "Honda (DogenSpiriorProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder DogenSpiriorProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": []
 },
 "variants": [
  {
   "name": "Honda spirior 2015-2017, all trims"
  }
 ],
 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 2,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "vehicle_speed": {
     "start_byte": 1,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "speed"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_hood": {
     "start_byte": 2,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x31": {
   "name": "Message 0x31",
   "signals": {
    "hvac_ac": {
     "start_byte": 0,
     "start_bit": 0,
     "bit_length": 2,
     "role": "hvac.ac",
     "label": "ac on off"
    },
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 6,
       "role": "hvac.power"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 1,
     "bits": {
      "air recirc on off": {
       "bit": 4,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 2,
     "bits": {
      "front defrost on off": {
       "bit": 4,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 2,
     "bits": {
      "rear defrost on off": {
       "bit": 5,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 5,
     "signed": true,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "outside_temp": {
     "start_byte": 11,
     "factor": 0.5,
     "offset": -40.0,
     "role": "outside.temp",
     "unit": "°C",
     "label": "outside temp"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2
 },
 "examples": [
  {
   "cmd": "0x11",
   "data": "04",
   "expect": {
    "back car state": true
   }
  },
  {
   "cmd": "0x12",
   "data": "00 00 04",
   "expect": {
    "front box door": true
   }
  },
  {
   "cmd": "0x31",
   "data": "01",
   "expect": {
