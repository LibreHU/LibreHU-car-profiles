{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "honda-bnrodyssey",
 "name": "Honda (BnrOdysseyProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder BnrOdysseyProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   },
   {
    "name": "car type",
    "cmd": "0xEF",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Honda odyssey 2009-2014, all trims",
   "send": {
    "car type": "01 01"
   }
  }
 ],
 "messages": {
  "0x24": {
   "name": "Message 0x24",
   "signals": {
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back car state": {
       "bit": 0,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 1,
     "bits": {
      "pstop block state": {
       "bit": 1,
       "role": "handbrake"
      }
     }
    }
   }
  },
  "0x29": {
   "name": "Message 0x29",
   "signals": {
    "steering_angle": {
     "start_byte": 0,
     "size": 2,
     "endian": "little",
     "factor": -0.54,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    }
   }
  },
  "0x20": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x20",
  "code_byte": 0
 },
 "examples": [
  {
   "cmd": "0x24",
   "data": "00 01",
   "expect": {
    "back car state": true
   }
  },
  {
   "cmd": "0x29",
   "data": "23 01",
   "expect": {
    "steering_angle": -157.14
   }
  },
  {
   "cmd": "0x20",
   "data": "12",
   "expect": {
    "wheel_key": 18.0
   }
  }
 ]
}