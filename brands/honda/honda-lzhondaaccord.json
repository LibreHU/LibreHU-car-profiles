{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "honda-lzhondaaccord",
 "name": "Honda (LzHondaAccordProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder LzHondaAccordProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Honda accord 2008-2013, all trims"
  }
 ],
 "messages": {
  "0x01": {
   "name": "Message 0x01",
   "signals": {
    "front_wind_mode": {
     "start_byte": 0,
     "values": {
      "0": "0",
      "1": "2",
      "2": "6",
      "3": "4",
      "4": "5",
      "5": "0",
      "6": "0",
      "7": "0"
     },
     "label": "front wind mode"
    },
    "hvac_fan": {
     "start_byte": 0,
     "start_bit": 3,
     "bit_length": 3,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "hvac_ac": {
     "start_byte": 0,
     "start_bit": 6,
     "bit_length": 2,
     "role": "hvac.ac",
     "label": "ac on off"
    },
    "auto_recirc_on_off": {
     "start_byte": 3,
     "bits": {
      "auto recirc on off": 7
     }
    }
   }
  },
  "0x60": {
   "name": "Message 0x60",
   "signals": {
    "door_trunk": {
     "start_byte": 0,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 0,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 0,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 0,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 0,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x61": {
   "name": "Message 0x61",
   "signals": {
    "engine_rpm": {
     "start_byte": 0,
     "size": 2,
     "role": "engine.rpm",
     "unit": "rpm",
     "label": "rotationl speed"
    },
    "vehicle_speed": {
     "start_byte": 4,
     "size": 2,
     "factor": 0.062486,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "current speed"
    },
    "vehicle_odometer": {
     "start_byte": 6,
     "size": 3,
     "role": "vehicle.odometer",
     "unit": "km",
     "label": "total mileage"
    },
    "turn_right": {
     "start_byte": 10,
     "bits": {
      "right turn light": {
       "bit": 1,
       "role": "turn.right"
      }
     }
    },
    "turn_left": {
     "start_byte": 10,
     "bits": {
      "left turn light": {
       "bit": 2,
       "role": "turn.left"
      }
     }
    }
   }
  }
 },
 "examples": [
  {
   "cmd": "0x01",
   "data": "00",
   "expect": {
    "front_wind_mode": "0"
   }
  },
  {
   "cmd": "0x60",
   "data": "08",
   "expect": {
    "tail box door": true
   }
  },
  {
   "cmd": "0x61",
   "data": "01 23",
   "expect": {
    "engine_rpm": 291.0
   }
  }
 ]
}