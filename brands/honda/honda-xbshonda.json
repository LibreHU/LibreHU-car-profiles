{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "honda-xbshonda",
 "name": "Honda (XbsHondaProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder XbsHondaProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Honda accord 2008-2012, all trims"
  },
  {
   "name": "Honda spirior 2009, all trims"
  }
 ],
 "messages": {
  "0x02": {
   "name": "Message 0x02",
   "signals": {
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 0,
     "bits": {
      "air recirc on off": {
       "bit": 5,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 7,
       "role": "hvac.power"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 4,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "front_wind_mode": {
     "start_byte": 1,
     "values": {
      "0": "0",
      "1": "4",
      "2": "2",
      "3": "6",
      "4": "1",
      "5": "5",
      "6": "3",
      "7": "7"
     },
     "label": "front wind mode"
    }
   }
  },
  "0x0E": {
   "name": "Message 0x0E",
   "signals": {
    "vehicle_odometer": {
     "start_byte": 10,
     "size": 4,
     "endian": "little",
     "signed": true,
     "role": "vehicle.odometer",
     "unit": "km",
     "label": "total mileage"
    }
   }
  },
  "0x0F": {
   "name": "Message 0x0F",
   "signals": {
    "steering_angle": {
     "start_byte": 0,
     "size": 2,
     "endian": "little",
     "factor": 1.164,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    }
   }
  },
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "door_hood": {
     "start_byte": 0,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 0,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 0,
     "bits": {
      "left back door": {
       "bit": 4,
       "role": "door.rear_left"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 0,
     "bits": {
      "right back door": {
       "bit": 5,
       "role": "door.rear_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 0,
     "bits": {
      "left front door": {
       "bit": 6,
       "role": "door.front_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 0,
     "bits": {
      "right front door": {
       "bit": 7,
       "role": "door.front_right"
      }
     }
    }
   }
  },
  "0x01": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x01",
  "code_byte": 0
 },
