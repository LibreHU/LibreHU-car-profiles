{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "honda-hd15crv",
 "name": "Honda (Hd15CrvProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder Hd15CrvProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "car type",
    "cmd": "0x2D",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Honda civic 2014-2015, medium-high trim",
   "send": {
    "car type": "00 02"
   }
  }
 ],
 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 2,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "vehicle_speed": {
     "start_byte": 1,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "speed"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_hood": {
     "start_byte": 2,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x41": {
   "name": "Message 0x41",
   "signals": {
    "radar_shown": {
     "start_byte": 10,
     "signed": true,
     "role": "radar.shown",
     "label": "radar show on off"
    },
    "front_right_distance": {
     "start_byte": 7,
     "size": 4,
     "factor": -0.0,
     "offset": 4.0953,
     "signed": true,
     "label": "front right distance"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2
 },
 "examples": [
  {
   "cmd": "0x11",
   "data": "04",
   "expect": {
    "back car state": true
   }
  },
  {
   "cmd": "0x12",
   "data": "00 00 04",
   "expect": {
    "front box door": true
   }
  },
  {
   "cmd": "0x41",
   "data": "00 00 00 00 00 00 00 00 00 00 12",
   "expect": {
    "radar_shown": 18.0
   }
  }
 ]
}