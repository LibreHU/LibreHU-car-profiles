{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "lifan-hdlifanx70",
 "name": "Lifan (HdLifanX70Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder HdLifanX70Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "car type",
    "cmd": "0x24",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Lifan X70 2020, all trims",
   "send": {
    "car type": "01 12"
   }
  }
 ],
 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "lights_parking": {
     "start_byte": 0,
     "bits": {
      "illlight": {
       "bit": 1,
       "role": "lights.parking"
      }
     }
    },
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 2,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x1A": {
   "name": "Message 0x1A",
   "signals": {
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back car state": {
       "bit": 1,
       "role": "gear.reverse"
      }
     }
    },
    "door_hood": {
     "start_byte": 1,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 1,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 1,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 1,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 1,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 1,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    },
    "turn_right": {
     "start_byte": 2,
     "bits": {
      "right turn light": {
       "bit": 0,
       "role": "turn.right"
      }
     }
    },
    "turn_left": {
     "start_byte": 2,
     "bits": {
      "left turn light": {
       "bit": 1,
       "role": "turn.left"
      }
     }
    },
    "vehicle_speed": {
     "start_byte": 3,
     "size": 2,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "current speed"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2
 },
 "examples": [
  {
   "cmd": "0x11",
   "data": "02",
   "expect": {
    "illlight": true
   }
  },
  {
   "cmd": "0x1A",
   "data": "00 02",
   "expect": {
    "back car state": true
   }
  }
 ]
}