{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "subaru-odsubaruxv",
 "name": "Subaru (OdSubaruXvProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder OdSubaruXvProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Subaru Legacy 2020, all trims"
  },
  {
   "name": "Subaru XV 2019, all trims"
  }
 ],
