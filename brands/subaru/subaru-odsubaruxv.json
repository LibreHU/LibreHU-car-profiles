   "signals": {
    "hvac_defrost_rear": {
     "start_byte": 0,
     "bits": {
      "rear defrost on off": {
       "bit": 1,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 0,
     "start_bit": 4,
     "bit_length": 2,
     "role": "hvac.recirculation",
     "label": "air recirc on off"
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_fan": {
