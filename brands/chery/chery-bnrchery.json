      "left back door": {
       "bit": 4,
       "role": "door.rear_left"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 0,
     "bits": {
      "right back door": {
       "bit": 5,
       "role": "door.rear_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 0,
     "bits": {
      "left front door": {
       "bit": 6,
       "role": "door.front_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 0,
     "bits": {
      "right front door": {
       "bit": 7,
       "role": "door.front_right"
      }
     }
