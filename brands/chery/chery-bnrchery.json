{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "chery-bnrchery",
 "name": "Chery (BnrCheryProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder BnrCheryProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   },
   {
    "name": "car type",
    "cmd": "0x90",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Chery A3 2010~2012, all trims",
   "send": {
    "car type": "10 00"
   }
  },
  {
   "name": "Chery arizet 2016, all trims",
   "send": {
    "car type": "10 00"
   }
  },
  {
   "name": "Chery arizet 2016~2019, all trims",
   "send": {
    "car type": "10 00"
   }
  },
  {
   "name": "Chery arizet other, all trims",
   "send": {
    "car type": "10 00"
   }
  }
 ],
 "messages": {
  "0x1F": {
   "name": "Message 0x1F",
   "signals": {
    "outside_temp": {
     "start_byte": 1,
     "factor": 0.5,
     "offset": -55.0,
     "max_value": 254,
     "role": "outside.temp",
     "unit": "°C",
     "label": "out ctemp"
    }
   }
  },
  "0x23": {
   "name": "Message 0x23",
   "signals": {
    "rear_left_distance": {
     "start_byte": 0,
     "offset": -1.0,
     "max_value": 7,
     "label": "rear left distance"
    },
    "rear_left_mid_distance": {
     "start_byte": 1,
     "offset": -1.0,
     "max_value": 7,
     "label": "rear left mid distance"
    },
    "rear_right_mid_distance": {
     "start_byte": 2,
     "offset": -1.0,
     "max_value": 7,
     "label": "rear right mid distance"
    },
    "rear_right_distance": {
     "start_byte": 3,
     "offset": -1.0,
     "max_value": 7,
     "label": "rear right distance"
    }
   }
  },
  "0x24": {
