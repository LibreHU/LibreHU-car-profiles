{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "chery-odmaserati",
 "name": "Chery (OdMaseratiProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder OdMaseratiProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Chery Ghibli 2014~2016, all trims"
  },
  {
   "name": "Chery Quattroporte 2013~2015, all trims"
  }
 ],
