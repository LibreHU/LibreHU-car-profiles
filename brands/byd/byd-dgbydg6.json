{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "byd-dgbydg6",
 "name": "BYD (DgBydG6Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder DgBydG6Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "BYD ModelG6 2011-2013, all trims"
  }
 ],
 "messages": {
  "0x32": {
   "name": "Message 0x32",
   "signals": {
    "rear_left_distance": {
     "start_byte": 2,
     "label": "rear left distance"
    },
    "rear_left_mid_distance": {
     "start_byte": 3,
     "start_bit": 0,
     "bit_length": 7,
     "label": "rear left mid distance"
    },
    "rear_right_mid_distance": {
     "start_byte": 4,
     "label": "rear right mid distance"
    },
    "rear_right_distance": {
     "start_byte": 5,
     "start_bit": 0,
     "bit_length": 7,
     "label": "rear right distance"
    }
   }
  },
  "0x76": {
   "name": "Message 0x76",
   "signals": {
    "vehicle_speed": {
     "start_byte": 0,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "speed"
    },
    "gear_reverse": {
     "start_byte": 2,
     "signed": true,
     "role": "gear.reverse",
     "label": "back car state"
    }
   }
  },
  "0xB1": {
   "name": "Message 0xB1",
   "signals": {
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 3,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "front_wind_mode": {
     "start_byte": 1,
     "values": {
      "0": "0",
      "1": "2",
      "2": "6",
      "3": "4",
      "4": "5",
      "5": "1",
      "6": "0",
      "7": "0"
     },
     "label": "front wind mode"
    },
    "hvac_ac": {
     "start_byte": 3,
     "bits": {
      "ac on off": {
       "bit": 0,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 3,
     "values": {
      "0": "-2147483648",
      "1": "1",
      "2": "0",
      "3": "-2147483648"
     },
     "label": "air recirc on off"
    },
    "auto_recirc_on_off": {
     "start_byte": 3,
     "bits": {
      "auto recirc on off": 2
     }
    },
    "hvac_dual": {
     "start_byte": 3,
     "bits": {
      "dual on off": {
       "bit": 4,
       "role": "hvac.dual"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 3,
     "bits": {
      "rear defrost on off": {
       "bit": 5,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_auto": {
     "start_byte": 4,
     "bits": {
      "auto light1": {
       "bit": 0,
       "role": "hvac.auto"
      }
     }
    }
   }
  },
  "0x06": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x06",
  "code_byte": 0
 },
 "examples": [
  {
   "cmd": "0x32",
   "data": "00 00 12",
   "expect": {
    "rear_left_distance": 18.0
   }
  },
  {
   "cmd": "0x76",
   "data": "12",
   "expect": {
    "vehicle_speed": 18.0
   }
  },
  {
   "cmd": "0xB1",
   "data": "00 01",
   "expect": {
    "hvac_fan": 1.0
   }
  },
  {
   "cmd": "0x06",
   "data": "12",
   "expect": {
    "wheel_key": 18.0
   }
  }
 ]
}