 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "steering_angle": {
     "start_byte": 6,
     "size": 2,
     "factor": -1.0,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x31": {
   "name": "Message 0x31",
   "signals": {
    "hvac_auto": {
