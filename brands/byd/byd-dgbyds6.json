{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "byd-dgbyds6",
 "name": "BYD (DgBydS6Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder DgBydS6Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "BYD S6 2011-2014, high trim"
  },
  {
   "name": "BYD S6 2011-2014, low trim"
  }
 ],
 "messages": {
  "0x04": {
   "name": "Message 0x04",
   "signals": {
    "door_front_left": {
     "start_byte": 1,
     "bits": {
      "left front door": {
       "bit": 0,
       "role": "door.front_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 1,
     "bits": {
      "right front door": {
       "bit": 1,
       "role": "door.front_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 1,
     "bits": {
      "left back door": {
       "bit": 2,
       "role": "door.rear_left"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 1,
     "bits": {
      "right back door": {
       "bit": 3,
       "role": "door.rear_right"
      }
     }
    },
    "door_trunk": {
     "start_byte": 1,
     "bits": {
      "tail box door": {
       "bit": 4,
       "role": "door.trunk"
      }
     }
    },
    "door_hood": {
     "start_byte": 1,
     "bits": {
      "front box door": {
       "bit": 5,
       "role": "door.hood"
      }
     }
    }
   }
  },
  "0x65": {
   "name": "Message 0x65",
   "signals": {
    "engine_rpm": {
     "start_byte": 0,
     "size": 2,
     "role": "engine.rpm",
     "unit": "rpm",
     "label": "rotation rate"
    },
    "vehicle_speed": {
     "start_byte": 2,
     "size": 2,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "speed"
    }
   }
  },
  "0x06": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x06",
  "code_byte": 0
 },
 "examples": [
  {
   "cmd": "0x04",
   "data": "00 01",
   "expect": {
    "left front door": true
   }
  },
  {
   "cmd": "0x65",
   "data": "01 23",
   "expect": {
    "engine_rpm": 291.0
   }
  },
  {
   "cmd": "0x06",
   "data": "12",
   "expect": {
    "wheel_key": 18.0
   }
  }
 ]
}