{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "byd-cytbydf6",
 "name": "BYD (CytBydF6Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder CytBydF6Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "BYD ModelF6 2008-2011, all trims"
  },
  {
   "name": "BYD ModelG6 2011-2013, all trims"
  }
 ],
 "messages": {
  "0x03": {
   "name": "Message 0x03",
   "signals": {
    "front_left_distance": {
     "start_byte": 0,
     "signed": true,
     "label": "front left distance"
    },
    "front_left_mid_distance": {
     "start_byte": 1,
     "signed": true,
     "label": "front left mid distance"
    },
    "front_right_mid_distance": {
     "start_byte": 2,
     "signed": true,
     "label": "front right mid distance"
    },
    "front_right_distance": {
     "start_byte": 3,
     "signed": true,
     "label": "front right distance"
    },
    "rear_left_distance": {
     "start_byte": 4,
     "signed": true,
     "label": "rear left distance"
    },
    "rear_left_mid_distance": {
     "start_byte": 5,
     "signed": true,
     "label": "rear left mid distance"
    },
    "rear_right_mid_distance": {
     "start_byte": 6,
     "signed": true,
     "label": "rear right mid distance"
    },
    "rear_right_distance": {
     "start_byte": 7,
     "signed": true,
     "label": "rear right distance"
    }
   }
  },
  "0x24": {
   "name": "Message 0x24",
   "signals": {
    "door_front_left": {
     "start_byte": 0,
     "bits": {
      "left front door": {
       "bit": 0,
       "role": "door.front_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 0,
     "bits": {
      "right front door": {
       "bit": 1,
       "role": "door.front_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 0,
     "bits": {
      "left back door": {
       "bit": 2,
       "role": "door.rear_left"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 0,
     "bits": {
      "right back door": {
       "bit": 3,
       "role": "door.rear_right"
      }
     }
    },
    "door_trunk": {
     "start_byte": 0,
     "mask": "0x50",
     "values": {
      "0": "0",
      "16": "1",
      "64": "1",
      "80": "1"
     },
     "label": "tail box door"
    },
    "door_hood": {
     "start_byte": 0,
     "bits": {
      "front box door": {
       "bit": 5,
       "role": "door.hood"
      }
     }
    },
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back car state": {
       "bit": 0,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 1,
     "bits": {
      "pstop block state": {
       "bit": 1,
       "role": "handbrake"
      }
     }
    }
   }
  },
  "0x26": {
   "name": "Message 0x26",
   "signals": {
    "steering_angle": {
     "start_byte": 0,
     "size": 2,
     "endian": "little",
     "factor": -1.0,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    }
   }
  },
  "0x35": {
   "name": "Message 0x35",
   "signals": {
    "hvac_seat_heat_left": {
     "start_byte": 0,
     "signed": true,
     "role": "hvac.seat_heat_left",
     "label": "fl seat warmer level"
    },
    "hvac_seat_heat_right": {
     "start_byte": 1,
     "signed": true,
     "role": "hvac.seat_heat_right",
     "label": "fr seat warmer level"
    }
   }
  },
  "0x41": {
   "name": "Message 0x41",
   "signals": {
    "engine_rpm": {
     "start_byte": 1,
     "role": "engine.rpm",
     "unit": "rpm",
     "label": "rotation rate"
    },
    "vehicle_speed": {
     "start_byte": 3,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "speed"
    }
   }
  },
  "0x55": {
   "name": "Message 0x55",
   "signals": {
    "hvac_temp_left": {
     "start_byte": 0,
     "factor": 0.5,
     "role": "hvac.temp_left",
     "unit": "°C",
     "label": "front left temp"
    },
    "hvac_temp_right": {
     "start_byte": 1,
     "factor": 0.5,
     "role": "hvac.temp_right",
     "unit": "°C",
     "label": "front right temp"
    },
    "hvac_fan": {
     "start_byte": 2,
     "start_bit": 0,
     "bit_length": 4,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "front_wind_mode": {
     "start_byte": 2,
     "values": {
      "0": "2",
      "1": "2",
      "2": "6",
      "3": "4",
      "4": "5",
      "5": "5",
      "6": "1",
      "7": "1",
      "8": "1",
      "9": "1",
      "10": "1",
      "11": "1",
      "12": "1",
      "13": "1",
      "14": "1",
      "15": "1"
     },
     "label": "front wind mode"
    },
    "hvac_auto": {
     "start_byte": 4,
     "bits": {
      "auto light1": {
       "bit": 0,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 4,
     "bits": {
      "ac on off": {
       "bit": 1,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_dual": {
     "start_byte": 4,
     "bits": {
      "dual on off": {
       "bit": 2,
       "role": "hvac.dual"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 4,
     "bits": {
      "front defrost on off": {
       "bit": 5,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 4,
     "bits": {
      "rear defrost on off": {
       "bit": 6,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "outside_temp": {
     "start_byte": 7,
     "max_value": 119,
     "role": "outside.temp",
     "unit": "°C",
     "label": "outside temp"
    }
   }
  }
 },
 "examples": [
  {
   "cmd": "0x03",
   "data": "12",
   "expect": {
    "front_left_distance": 18.0
   }
  },
  {
   "cmd": "0x24",
   "data": "01",
   "expect": {
    "left front door": true
   }
  },
  {
   "cmd": "0x26",
   "data": "23 01",
   "expect": {
    "steering_angle": -291.0
   }
  },
  {
   "cmd": "0x35",
   "data": "12",
   "expect": {
    "hvac_seat_heat_left": 18.0
   }
  }
 ]
}