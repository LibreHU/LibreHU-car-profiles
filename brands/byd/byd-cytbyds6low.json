{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.7",
 "id": "byd-cytbyds6low",
 "name": "BYD (CytBydS6LowProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder CytBydS6LowProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: cyt-55-fixed.",
 "box": "cyt-55-fixed",
 "baud": 9600,
 "link": {
  "ack": false,
  "send": []
 },
 "variants": [
  {
   "name": "BYD S6 2011-2014, low trim"
  }
 ],
