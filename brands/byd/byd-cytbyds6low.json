     "signed": true,
     "role": "hvac.temp_right",
     "unit": "°C",
     "label": "front right temp"
    },
    "hvac_power": {
     "start_byte": 2,
     "bits": {
      "air on off": {
       "bit": 0,
       "role": "hvac.power"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 2,
     "start_bit": 0,
     "bit_length": 3,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "hvac_auto": {
     "start_byte": 4,
     "bits": {
      "auto light1": {
       "bit": 0,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 4,
     "bits": {
      "ac on off": {
       "bit": 1,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 4,
     "bits": {
      "air recirc on off": {
       "bit": 3,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_dual": {
     "start_byte": 4,
     "bits": {
      "dual on off": {
       "bit": 4,
       "role": "hvac.dual"
      }
     }
