    "hvac_defrost_front": {
     "start_byte": 4,
     "bits": {
      "front defrost on off": {
       "bit": 5,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 4,
     "bits": {
      "rear defrost on off": {
       "bit": 6,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "outside_temp": {
     "start_byte": 5,
     "offset": -128.0,
     "role": "outside.temp",
     "unit": "°C",
     "label": "outside temp"
    }
   }
  }
 },
 "examples": [
