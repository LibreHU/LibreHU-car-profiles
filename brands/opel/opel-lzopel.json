{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "opel-lzopel",
 "name": "Opel (LzOpelProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder LzOpelProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Opel antara 2011, all trims"
  },
  {
   "name": "Opel 兼容 兼容, all trims"
  }
 ],
 "messages": {
  "0x08": {
   "name": "Message 0x08",
   "signals": {
    "hvac_recirculation": {
     "start_byte": 0,
     "bits": {
      "air recirc on off": {
       "bit": 5,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 7,
       "role": "hvac.power"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 4,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "front_wind_mode": {
     "start_byte": 1,
     "values": {
      "0": "0",
      "1": "4",
      "2": "2",
      "3": "6",
      "4": "1",
      "5": "5",
      "6": "3",
      "7": "7"
     },
     "label": "front wind mode"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "tpms_front_left_pressure": {
     "start_byte": 4,
     "factor": 0.1,
     "role": "tpms.front_left.pressure",
     "label": "front left tire pre value"
    },
    "tpms_rear_left_pressure": {
     "start_byte": 5,
     "factor": 0.1,
     "role": "tpms.rear_left.pressure",
     "label": "rear left tire pre value"
    },
    "tpms_front_right_pressure": {
     "start_byte": 6,
     "factor": 0.1,
     "role": "tpms.front_right.pressure",
     "label": "front right tire pre value"
    },
    "tpms_rear_right_pressure": {
     "start_byte": 7,
     "factor": 0.1,
     "role": "tpms.rear_right.pressure",
     "label": "rear right tire pre value"
    }
   }
  },
  "0x0E": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x0E",
  "code_byte": 0
 },
 "examples": [
  {
   "cmd": "0x08",
   "data": "20",
   "expect": {
    "air recirc on off": true
   }
  },
  {
   "cmd": "0x12",
   "data": "00 00 00 00 12",
   "expect": {
    "tpms_front_left_pressure": 1.8
   }
  },
  {
   "cmd": "0x0E",
   "data": "12",
   "expect": {
    "wheel_key": 18.0
   }
  }
 ]
}