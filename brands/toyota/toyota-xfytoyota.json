{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "toyota-xfytoyota",
 "name": "Toyota (XFYToyotaProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder XFYToyotaProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Toyota Fortuner 2016, all trims"
  },
  {
   "name": "Toyota 兼容 兼容, all trims"
  }
 ],
 "messages": {
  "0x55": {
   "name": "Message 0x55",
   "signals": {
    "hvac_temp_left": {
     "start_byte": 0,
     "factor": 0.5,
     "role": "hvac.temp_left",
     "unit": "°C",
     "label": "front left temp"
    },
    "hvac_temp_right": {
     "start_byte": 1,
     "factor": 0.5,
     "role": "hvac.temp_right",
     "unit": "°C",
     "label": "front right temp"
    },
    "hvac_fan": {
     "start_byte": 2,
     "start_bit": 0,
     "bit_length": 3,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "hvac_power": {
     "start_byte": 2,
     "bits": {
      "air on off": {
       "bit": 0,
       "role": "hvac.power"
      }
     }
    },
    "hvac_seat_heat_left": {
     "start_byte": 3,
     "start_bit": 0,
     "bit_length": 2,
     "role": "hvac.seat_heat_left",
     "label": "fl seat warmer level"
    },
    "hvac_seat_heat_right": {
     "start_byte": 3,
     "start_bit": 4,
     "bit_length": 2,
     "role": "hvac.seat_heat_right",
     "label": "fr seat warmer level"
    },
    "hvac_auto": {
     "start_byte": 4,
     "bits": {
      "auto light1": {
       "bit": 0,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 4,
     "bits": {
      "ac on off": {
       "bit": 1,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_dual": {
     "start_byte": 4,
     "bits": {
      "dual on off": {
       "bit": 2,
       "role": "hvac.dual"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 4,
     "bits": {
      "air recirc on off": {
       "bit": 3,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 4,
     "bits": {
      "rear defrost on off": {
       "bit": 6,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "outside_temp": {
     "start_byte": 5,
     "offset": -40.0,
     "signed": true,
     "role": "outside.temp",
     "unit": "°C",
     "label": "outside temp"
    }
   }
  },
  "0x56": {
   "name": "Message 0x56",
   "signals": {
    "hvac_auto": {
     "start_byte": 4,
     "bits": {
      "auto light1": {
       "bit": 0,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_dual": {
     "start_byte": 4,
     "bits": {
      "dual on off": {
       "bit": 2,
       "role": "hvac.dual"
      }
     }
    }
   }
  }
 },
 "examples": [
  {
   "cmd": "0x55",
   "data": "12",
   "expect": {
    "hvac_temp_left": 9.0
   }
  },
  {
   "cmd": "0x56",
   "data": "00 00 00 00 01",
   "expect": {
    "auto light1": true
   }
  }
 ]
}