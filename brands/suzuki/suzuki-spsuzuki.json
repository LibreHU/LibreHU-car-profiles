       "role": "door.front_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 0,
     "bits": {
      "right front door": {
       "bit": 7,
       "role": "door.front_right"
      }
     }
    },
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back state": {
       "bit": 0,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 1,
     "bits": {
      "handbrake": {
       "bit": 1,
       "role": "handbrake"
      }
     }
    }
   }
  },
  "0x29": {
   "name": "Message 0x29",
   "signals": {
