{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "suzuki-spsuzuki",
 "name": "Suzuki (SpSuzukiProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder SpSuzukiProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise. Cars marked « (same protocol) » have no decoder in Car Info: their box maker's protocol document is the one this decoder implements.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Suzuki 兼容 兼容, all trims"
  },
  {
   "name": "Suzuki S-Cross 102022, all trims (same protocol)"
  },
  {
   "name": "Suzuki Grand Vitara 102022, all trims (same protocol)"
  }
 ],
