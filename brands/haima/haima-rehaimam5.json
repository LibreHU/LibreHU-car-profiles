{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "haima-rehaimam5",
 "name": "Haima (ReHaimaM5Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder ReHaimaM5Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Haima M3 2016, all trims"
  },
  {
   "name": "Haima V70 2016, all trims"
  },
  {
   "name": "Haima family f5 2018, all trims"
  },
  {
   "name": "Haima m5 2014, all trims"
  }
 ],
 "messages": {
  "0x23": {
   "name": "Message 0x23",
   "signals": {
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 0,
     "bits": {
      "air recirc on off": {
       "bit": 5,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 7,
       "role": "hvac.power"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 4,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "hvac_defrost_rear": {
     "start_byte": 4,
     "bits": {
      "rear defrost on off": {
       "bit": 6,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 4,
     "bits": {
      "front defrost on off": {
       "bit": 7,
       "role": "hvac.defrost_front"
      }
     }
    }
   }
  },
  "0x30": {
   "name": "Message 0x30",
   "signals": {
    "steering_angle": {
     "start_byte": 0,
     "size": 2,
     "endian": "little",
     "factor": -0.0879,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    }
   }
  },
  "0x21": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x21",
  "code_byte": 0
 },
 "examples": [
