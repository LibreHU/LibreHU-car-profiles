{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "jac-bnrjac",
 "name": "JAC (BnrJacProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder BnrJacProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "JAC S2 2015-2017, all trims"
  },
  {
   "name": "JAC S3 2014-2017, all trims"
  }
 ],
