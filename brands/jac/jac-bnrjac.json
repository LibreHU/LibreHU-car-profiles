      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 0,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 0,
     "bits": {
      "left back door": {
       "bit": 4,
       "role": "door.rear_left"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 0,
     "bits": {
      "right back door": {
       "bit": 5,
       "role": "door.rear_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 0,
     "bits": {
      "left front door": {
       "bit": 6,
       "role": "door.front_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 0,
     "bits": {
      "right front door": {
       "bit": 7,
       "role": "door.front_right"
      }
     }
    },
    "seatbelt_driver": {
     "start_byte": 1,
     "bits": {
      "safety belt": {
       "bit": 3,
       "role": "seatbelt.driver"
      }
     }
    },
    "handbrake": {
     "start_byte": 1,
     "bits": {
      "pstop block state": {
       "bit": 4,
       "role": "handbrake"
      }
     }
    },
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back car state": {
       "bit": 6,
       "role": "gear.reverse"
      }
     }
    }
   }
  },
  "0x38": {
   "name": "Message 0x38",
   "signals": {
    "tpms_front_left_temperature": {
     "start_byte": 0,
     "offset": -40.0,
     "role": "tpms.front_left.temperature",
     "label": "front left tire temp value"
    },
    "tpms_front_right_temperature": {
     "start_byte": 1,
     "offset": -40.0,
     "role": "tpms.front_right.temperature",
     "label": "front right tire temp value"
    },
    "tpms_rear_left_temperature": {
     "start_byte": 2,
     "offset": -40.0,
     "role": "tpms.rear_left.temperature",
     "label": "rear left tire temp value"
    },
    "tpms_rear_right_temperature": {
     "start_byte": 3,
     "offset": -40.0,
     "role": "tpms.rear_right.temperature",
     "label": "rear right tire temp value"
    }
   }
  },
  "0x21": {
