{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "bmw-lzbmwmini",
 "name": "BMW (LzBMWMiniProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder LzBMWMiniProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "BMW MINI 2004-2013, all trims"
  },
  {
   "name": "BMW MINI 2019, all trims"
  }
 ],
 "messages": {
  "0x21": {
   "name": "Message 0x21",
   "signals": {
    "vehicle_speed": {
     "start_byte": 0,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "current speed"
    },
    "turn_left": {
     "start_byte": 3,
     "bits": {
      "left turn light": {
       "bit": 6,
       "role": "turn.left"
      }
     }
    },
    "turn_right": {
     "start_byte": 3,
     "bits": {
      "right turn light": {
       "bit": 7,
       "role": "turn.right"
      }
     }
    }
   }
  },
  "0x20": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key",
     "values": {
      "1": "volume +",
      "2": "volume -",
      "3": "next",
      "4": "previous",
      "5": "answer",
      "6": "mute",
      "7": "mode",
      "10": "up",
      "11": "down",
      "12": "left",
      "13": "right",
      "15": "enter",
      "16": "home",
      "17": "list"
     }
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x20",
  "code_byte": 0,
  "names": {
   "1": "volume +",
   "2": "volume -",
   "3": "next",
   "4": "previous",
   "5": "answer",
   "6": "mute",
   "7": "mode",
   "10": "up",
   "11": "down",
   "12": "left",
