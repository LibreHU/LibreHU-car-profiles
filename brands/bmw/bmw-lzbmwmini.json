   "15": "enter",
   "16": "home",
   "17": "list"
  }
 },
 "examples": [
  {
   "cmd": "0x21",
   "data": "12",
   "expect": {
    "vehicle_speed": 18.0
   }
  },
  {
   "cmd": "0x20",
   "data": "01",
   "expect": {
    "wheel_key": "volume +"
   }
  }
 ]
}