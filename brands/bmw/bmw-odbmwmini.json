       "bit": 5,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 4,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "front_wind_mode": {
     "start_byte": 1,
     "values": {
      "0": "0",
      "1": "4",
      "2": "2",
      "3": "6",
      "4": "1",
      "5": "5",
      "6": "3",
      "7": "7"
     },
     "label": "front wind mode"
    },
    "hvac_seat_heat_right": {
     "start_byte": 5,
     "start_bit": 0,
     "bit_length": 3,
     "role": "hvac.seat_heat_right",
     "label": "fr seat warmer level"
    },
    "hvac_seat_heat_left": {
     "start_byte": 5,
     "start_bit": 4,
     "bit_length": 3,
     "role": "hvac.seat_heat_left",
     "label": "fl seat warmer level"
    }
   }
  },
  "0x24": {
   "name": "Message 0x24",
   "signals": {
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back car state": {
       "bit": 0,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 1,
     "bits": {
      "pstop block state": {
       "bit": 1,
       "role": "handbrake"
      }
     }
    }
   }
  },
  "0x29": {
   "name": "Message 0x29",
   "signals": {
    "steering_angle": {
