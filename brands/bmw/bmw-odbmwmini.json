{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "bmw-odbmwmini",
 "name": "BMW (OdBmwMINIProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder OdBmwMINIProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "BMW MINI 2014-2020, all trims"
  }
 ],
 "messages": {
  "0x21": {
   "name": "Message 0x21",
   "signals": {
    "hvac_defrost_rear": {
     "start_byte": 0,
     "bits": {
      "rear defrost on off": {
       "bit": 0,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 0,
     "bits": {
      "front defrost on off": {
       "bit": 1,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_dual": {
     "start_byte": 0,
     "bits": {
      "dual on off": {
       "bit": 2,
       "role": "hvac.dual"
      }
     }
    },
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
