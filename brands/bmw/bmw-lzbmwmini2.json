{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "bmw-lzbmwmini2",
 "name": "BMW (LzBMWMini2Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder LzBMWMini2Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "BMW MINI 2015-2018, high trim"
  },
  {
   "name": "BMW MINI 2015-2018, low trim"
  }
 ],
 "messages": {
  "0x10": {
   "name": "Message 0x10",
   "signals": {
    "door_hood": {
     "start_byte": 1,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 1,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 1,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 1,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 1,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 1,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "outside_temp": {
     "start_byte": 3,
     "factor": 0.5,
     "sign_magnitude": true,
     "role": "outside.temp",
     "unit": "°C",
     "label": "outside temp"
    }
   }
  },
  "0x49": {
   "name": "Message 0x49",
   "signals": {
    "tpms_front_left_pressure": {
     "start_byte": 5,
     "size": 2,
     "endian": "little",
     "factor": 0.1,
     "role": "tpms.front_left.pressure",
     "label": "front left tire pre value"
    },
    "tpms_front_right_pressure": {
     "start_byte": 7,
     "size": 2,
     "endian": "little",
     "factor": 0.1,
     "role": "tpms.front_right.pressure",
     "label": "front right tire pre value"
    },
    "tpms_rear_left_pressure": {
     "start_byte": 9,
     "size": 2,
     "endian": "little",
     "factor": 0.1,
     "role": "tpms.rear_left.pressure",
     "label": "rear left tire pre value"
    },
    "tpms_rear_right_pressure": {
     "start_byte": 11,
     "size": 2,
     "endian": "little",
     "factor": 0.1,
     "role": "tpms.rear_right.pressure",
     "label": "rear right tire pre value"
    }
   }
  },
  "0x21": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x21",
