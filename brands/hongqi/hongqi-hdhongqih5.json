     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_hood": {
