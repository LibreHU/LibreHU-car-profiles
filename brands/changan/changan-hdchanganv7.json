     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
