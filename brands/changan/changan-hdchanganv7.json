     "size": 2,
     "factor": -1.0,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "seatbelt_driver": {
     "start_byte": 2,
     "bits": {
      "left safety belt": {
       "bit": 1,
       "role": "seatbelt.driver"
      }
     }
    },
    "door_hood": {
     "start_byte": 2,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
