 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "car type",
    "cmd": "0x24",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Changan alsvin v7 2015-now, high trim",
   "send": {
    "car type": "05 13"
   }
  },
  {
   "name": "Changan alsvin v7 2015-now, low trim",
   "send": {
    "car type": "06 13"
   }
  },
  {
   "name": "Changan yidong DT 2013, low trim",
   "send": {
    "car type": "07 13"
   }
  }
 ],
