{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "landrover-relandrover",
 "name": "Land Rover (ReLandroverProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder ReLandroverProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Land Rover Discovery 2015, all trims"
  },
  {
   "name": "Land Rover Evoque 2012, all trims"
  }
 ],
 "messages": {
  "0x21": {
   "name": "Message 0x21",
   "signals": {
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 3,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 0,
     "bits": {
      "air recirc on off": {
       "bit": 5,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 7,
       "role": "hvac.power"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 4,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "hvac_defrost_rear": {
     "start_byte": 4,
     "bits": {
      "rear defrost on off": {
       "bit": 6,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 4,
     "bits": {
      "front defrost on off": {
       "bit": 7,
       "role": "hvac.defrost_front"
      }
     }
    }
   }
  },
  "0x24": {
   "name": "Message 0x24",
   "signals": {
    "gear_reverse": {
     "start_byte": 1,
     "bits": {
      "back car state": {
       "bit": 0,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 1,
     "bits": {
      "pstop block state": {
       "bit": 1,
       "role": "handbrake"
      }
     }
    },
    "seatbelt_driver": {
     "start_byte": 1,
     "bits": {
      "left safety belt": {
       "bit": 6,
       "role": "seatbelt.driver"
      }
     }
    }
   }
  },
  "0x20": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x20",
  "code_byte": 0
 },
 "examples": [
  {
   "cmd": "0x21",
   "data": "08",
   "expect": {
    "auto light1": true
   }
  },
  {
   "cmd": "0x24",
   "data": "00 01",
   "expect": {
    "back car state": true
   }
  },
  {
   "cmd": "0x20",
   "data": "12",
   "expect": {
    "wheel_key": 18.0
   }
  }
 ]
}