{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "volkswagen-odoldtouareg",
 "name": "Volkswagen (OdOldTouaregProtocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder OdOldTouaregProtocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: raise.",
 "box": "raise",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   }
  ]
 },
 "variants": [
  {
   "name": "Volkswagen oldtouareg 2025-now, all trims"
  }
 ],
 "messages": {
  "0x16": {
   "name": "Message 0x16",
   "signals": {
    "vehicle_speed": {
     "start_byte": 0,
     "size": 2,
     "endian": "little",
     "factor": 0.0625,
     "role": "vehicle.speed",
     "unit": "km/h",
     "label": "current speed"
    }
   }
  },
  "0x21": {
   "name": "Message 0x21",
   "signals": {
    "hvac_dual": {
     "start_byte": 0,
     "bits": {
      "dual on off": {
       "bit": 2,
       "role": "hvac.dual"
      }
     }
    },
    "hvac_auto": {
     "start_byte": 0,
     "bits": {
      "auto light1": {
       "bit": 4,
       "role": "hvac.auto"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 0,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 1,
     "start_bit": 0,
     "bit_length": 3,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "hvac_power": {
     "start_byte": 1,
     "bits": {
      "air on off": {
       "bit": 4,
       "role": "hvac.power"
      }
     }
    },
    "front_wind_mode": {
     "start_byte": 1,
     "values": {
      "0": "4",
      "1": "2",
      "2": "1",
      "3": "1"
     },
     "label": "front wind mode"
    },
    "hvac_seat_heat_right": {
     "start_byte": 4,
     "start_bit": 0,
     "bit_length": 2,
     "role": "hvac.seat_heat_right",
     "label": "fr seat warmer level"
    },
    "hvac_seat_heat_left": {
     "start_byte": 4,
     "start_bit": 4,
     "bit_length": 2,
     "role": "hvac.seat_heat_left",
     "label": "fl seat warmer level"
    },
    "hvac_recirculation": {
     "start_byte": 4,
     "bits": {
      "air recirc on off": {
       "bit": 7,
       "role": "hvac.recirculation"
      }
     }
    }
   }
  },
  "0x24": {
   "name": "Message 0x24",
   "signals": {
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 0,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 1,
       "role": "handbrake"
      }
     }
    }
   }
  },
  "0x26": {
   "name": "Message 0x26",
   "signals": {
    "steering_angle": {
     "start_byte": 0,
     "size": 2,
     "endian": "little",
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    }
   }
  },
  "0x20": {
   "name": "Wheel key",
   "signals": {
    "wheel_key": {
     "start_byte": 0,
     "label": "wheel key"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x20",
  "code_byte": 0
 },
 "examples": [
  {
   "cmd": "0x16",
   "data": "23 01",
   "expect": {
    "vehicle_speed": 18.19
   }
  },
  {
   "cmd": "0x21",
   "data": "04",
   "expect": {
    "dual on off": true
   }
  },
  {
   "cmd": "0x24",
   "data": "01",
   "expect": {
    "back car state": true
   }
  },
  {
   "cmd": "0x26",
   "data": "23 01",
   "expect": {
    "steering_angle": 291.0
   }
  }
 ]
}