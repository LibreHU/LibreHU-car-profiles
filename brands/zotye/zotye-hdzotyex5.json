{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "zotye-hdzotyex5",
 "name": "Zotye (HdZotyeX5Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder HdZotyeX5Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "car type",
    "cmd": "0x24",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Zotye X5 2016, all trims",
   "send": {
    "car type": "02 20"
   }
  }
 ],
 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "lights_parking": {
     "start_byte": 0,
     "bits": {
      "illlight": {
       "bit": 1,
       "role": "lights.parking"
      }
     }
    },
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 2,
       "role": "gear.reverse"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "steering_angle": {
     "start_byte": 6,
     "size": 2,
     "factor": -1.0,
     "signed": true,
     "role": "steering.angle",
     "unit": "°",
     "label": "eps"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "seatbelt_driver": {
     "start_byte": 2,
     "bits": {
      "left safety belt": {
       "bit": 1,
       "role": "seatbelt.driver"
      }
     }
    },
    "door_hood": {
     "start_byte": 2,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x31": {
   "name": "Message 0x31",
   "signals": {
    "hvac_power": {
     "start_byte": 0,
     "bits": {
      "air on off": {
       "bit": 6,
       "role": "hvac.power"
      }
     }
    },
    "hvac_recirculation": {
     "start_byte": 1,
     "bits": {
      "air recirc on off": {
       "bit": 4,
       "role": "hvac.recirculation"
      }
     }
    },
    "hvac_ac": {
     "start_byte": 1,
     "bits": {
      "ac on off": {
       "bit": 6,
       "role": "hvac.ac"
      }
     }
    },
    "hvac_defrost_front": {
     "start_byte": 2,
     "bits": {
      "front defrost on off": {
       "bit": 4,
       "role": "hvac.defrost_front"
      }
     }
    },
    "hvac_defrost_rear": {
     "start_byte": 2,
     "bits": {
      "rear defrost on off": {
       "bit": 5,
       "role": "hvac.defrost_rear"
      }
     }
    },
    "hvac_fan": {
     "start_byte": 5,
     "signed": true,
     "role": "hvac.fan",
     "label": "front wind level"
    },
    "outside_temp": {
     "start_byte": 11,
     "factor": 0.5,
     "offset": -40.0,
     "role": "outside.temp",
     "unit": "°C",
     "label": "outside temp"
    }
   }
  },
  "0x37": {
   "name": "Message 0x37",
   "signals": {
    "tpms_front_left_pressure": {
     "start_byte": 3,
     "factor": 0.1,
     "role": "tpms.front_left.pressure",
     "label": "front left tire pre value"
    }
   }
  }
 },
 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2
 },
 "examples": [
  {
   "cmd": "0x11",
   "data": "02",
   "expect": {
    "illlight": true
   }
  },
  {
   "cmd": "0x12",
   "data": "00 00 02",
   "expect": {
    "left safety belt": true
   }
  },
  {
   "cmd": "0x31",
   "data": "40",
   "expect": {
    "air on off": true
   }
  },
  {
   "cmd": "0x37",
   "data": "00 00 00 12",
   "expect": {
    "tpms_front_left_pressure": 1.8
   }
  }
 ]
}