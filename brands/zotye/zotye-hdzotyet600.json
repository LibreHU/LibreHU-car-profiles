{
 "format": "librehu-can-vehicle",
 "version": 2,
 "engine": ">=2.0",
 "id": "zotye-hdzotyet600",
 "name": "Zotye (HdZotyeT600Protocol)",
 "description": "Generated by LibreHU-car-profiles tools/carinfo from the decoder HdZotyeT600Protocol of Car Info 1.0.3991 (com.can.activity), replayed without running the app. NEVER TRIED ON A CAR: check every value before relying on it. Box: hiworld.",
 "box": "hiworld",
 "baud": 38400,
 "link": {
  "ack": true,
  "send": [
   {
    "name": "car type",
    "cmd": "0x24",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },
 "variants": [
  {
   "name": "Zotye T600 2016, all trims",
   "send": {
    "car type": "01 20"
   }
  },
  {
   "name": "Zotye 兼容 兼容, all trims",
   "send": {
    "car type": "01 20"
   }
  }
 ],
 "messages": {
  "0x11": {
   "name": "Message 0x11",
   "signals": {
    "lights_parking": {
     "start_byte": 0,
     "bits": {
      "illlight": {
       "bit": 1,
       "role": "lights.parking"
      }
     }
    },
    "gear_reverse": {
     "start_byte": 0,
     "bits": {
      "back car state": {
       "bit": 2,
       "role": "gear.reverse"
      }
     }
    },
    "gear_park": {
     "start_byte": 0,
     "bits": {
      "park": {
       "bit": 3,
       "role": "gear.park"
      }
     }
    },
    "handbrake": {
     "start_byte": 0,
     "bits": {
      "pstop block state": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key"
    }
   }
  },
  "0x12": {
   "name": "Message 0x12",
   "signals": {
    "door_hood": {
     "start_byte": 2,
     "bits": {
      "front box door": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "door_trunk": {
     "start_byte": 2,
     "bits": {
      "tail box door": {
       "bit": 3,
       "role": "door.trunk"
      }
     }
    },
    "door_rear_right": {
     "start_byte": 2,
     "bits": {
      "right back door": {
       "bit": 4,
       "role": "door.rear_right"
      }
     }
    },
    "door_rear_left": {
     "start_byte": 2,
     "bits": {
      "left back door": {
       "bit": 5,
       "role": "door.rear_left"
      }
     }
    },
    "door_front_right": {
     "start_byte": 2,
     "bits": {
      "right front door": {
       "bit": 6,
       "role": "door.front_right"
      }
     }
    },
    "door_front_left": {
     "start_byte": 2,
     "bits": {
      "left front door": {
       "bit": 7,
       "role": "door.front_left"
      }
     }
    }
   }
  },
  "0x38": {
   "name": "Message 0x38",
   "signals": {
    "tpms_front_left_temperature": {
     "start_byte": 0,
     "max_value": 254,
     "role": "tpms.front_left.temperature",
     "label": "front left tire temp value"
    },
    "tpms_front_right_temperature": {
     "start_byte": 1,
     "max_value": 254,
     "role": "tpms.front_right.temperature",
     "label": "front right tire temp value"
    },
    "tpms_rear_left_temperature": {
     "start_byte": 2,
     "max_value": 254,
     "role": "tpms.rear_left.temperature",
     "label": "rear left tire temp value"
    },
    "tpms_rear_right_temperature": {
     "start_byte": 3,
     "max_value": 254,
     "role": "tpms.rear_right.temperature",
     "label": "rear right tire temp value"
    },
    "tpms_front_left_pressure": {
     "start_byte": 4,
     "factor": 0.1,
     "max_value": 254,
     "role": "tpms.front_left.pressure",
     "label": "front left tire pre value"
